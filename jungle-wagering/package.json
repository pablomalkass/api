{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Distributed wagering processor: idempotent, concurrent-safe wallet/ledger processing over HTTP and SQS.",
  "scripts": {
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "migration:up": "bun src/cli/migrate.ts up",
    "migration:down": "bun src/cli/migrate.ts down",
    "test": "bun test test/unit",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration --timeout 60000",
    "test:concurrency": "bun test test/concurrency --timeout 120000",
    "test:e2e": "bun test test/e2e --timeout 120000",
    "test:all": "bun test test/unit test/integration test/concurrency --timeout 120000",
    "compose:up": "docker compose up --build -d",
    "compose:down": "docker compose down -v",
    "test:load": "bun scripts/load-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/postgresql": "^6.4.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.0",
    "typescript": "^5.6.0"
  }
}
